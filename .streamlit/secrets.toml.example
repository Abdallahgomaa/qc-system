# نموذج ملف الأسرار (البند 2.6)
# ---------------------------------------------------------------------------
# الاستخدام المحلي: انسخ هذا الملف باسم  .streamlit/secrets.toml  ثم املأ القيم.
# على Streamlit Community Cloud: افتح التطبيق ▸ Settings ▸ Secrets، والصق
# محتوى هذا الملف نفسه (بعد تعبئة القيم).

SUPABASE_URL = "https://YOUR-PROJECT-ref.supabase.co"
# المفتاح العام (Publishable / anon) — يكفي لتشغيل التطبيق مع تسجيل دخول المستخدم
# لأن صلاحيات الجداول والتخزين محميّة بـ RLS. لا تُضِف مفتاح الخدمة (service_role) هنا.
SUPABASE_KEY = "sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX"

# ---------------------------------------------------------------------------
# اختياري (البند 4.2): إرسال إشعارات التنبيهات بالبريد.
# إن حُذف هذا القسم أو تُرك فارغاً يعمل التطبيق طبيعياً، ويبقى خيار مشاركة
# التنبيهات على واتساب (wa.me) متاحاً دون أي إعداد.
# ---------------------------------------------------------------------------
# [smtp]
# host = "smtp.gmail.com"
# port = 465
# user = "your-address@gmail.com"
# password = "app-password-not-your-login-password"
# sender = "your-address@gmail.com"
# recipients = "engineer1@example.com, manager@example.com"
